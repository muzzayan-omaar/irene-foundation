generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Donor {
  id           String     @id @default(cuid())
  fullName     String
  email        String     @unique
  phone        String?
  country      String?
  isSubscribed Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  donations    Donation[]

  @@index([email])
}

model Donation {
  id              String            @id @default(cuid())
  amount          Decimal           @db.Decimal(12, 2)
  currency        String            @default("USD")
  status          DonationStatus    @default(PENDING)
  frequency       DonationFrequency @default(ONE_TIME)
  paymentMethod   PaymentMethod
  flutterwaveTxId String?           @unique
  message         String?
  isAnonymous     Boolean           @default(false)
  createdAt       DateTime          @default(now())
  donorId         String
  campaignId      String?
  campaign        Campaign?         @relation(fields: [campaignId], references: [id])
  donor           Donor             @relation(fields: [donorId], references: [id])

  @@index([campaignId])
  @@index([status])
}

model Campaign {
  id         String         @id @default(cuid())
  title      String
  slug       String         @unique
  story      String
  coverImage String?
  goalAmount Decimal        @db.Decimal(12, 2)
  currency   String         @default("USD")
  status     CampaignStatus @default(DRAFT)
  startDate  DateTime?
  endDate    DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  activities Activity[]
  donations  Donation[]

  @@index([status])
  @@index([slug])
}

model Activity {
  id          String       @id @default(cuid())
  title       String
  slug        String       @unique
  type        ActivityType
  body        String
  mediaUrls   String[]
  isPublished Boolean      @default(false)
  publishedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  campaignId  String?
  authorId    String?
  author      AdminUser?   @relation(fields: [authorId], references: [id])
  campaign    Campaign?    @relation(fields: [campaignId], references: [id])

  @@index([campaignId])
  @@index([type])
  @@index([isPublished])
}

model Partner {
  id           String        @id @default(cuid())
  name         String
  logoUrl      String?
  website      String?
  contactName  String?
  contactEmail String?
  status       PartnerStatus @default(PROSPECTIVE)
  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([status])
}

model AdminUser {
  id          String     @id @default(cuid())
  supabaseUid String     @unique
  fullName    String
  email       String     @unique
  role        AdminRole  @default(EDITOR)
  createdAt   DateTime   @default(now())
  activities  Activity[]
}

model SupportPost {
  id         String         @id @default(cuid())
  authorName String
  platform   SocialPlatform @default(OTHER)
  content    String
  imageUrl   String?
  sourceUrl  String?
  isFeatured Boolean        @default(true)
  createdAt  DateTime       @default(now())

  @@index([isFeatured])
}

model PressMention {
  id            String    @id @default(cuid())
  outletName    String
  title         String
  url           String
  logoUrl       String?
  publishedDate DateTime?
  createdAt     DateTime  @default(now())

  @@index([publishedDate])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model SiteMetricSnapshot {
  id              String   @id @default(cuid())
  date            DateTime @default(now())
  totalRaised     Decimal  @db.Decimal(14, 2)
  totalDonors     Int
  newsletterCount Int
  siteVisitors    Int?

  @@index([date])
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  COMPLETED
  PAUSED
}

enum DonationStatus {
  PENDING
  SUCCESSFUL
  FAILED
}

enum DonationFrequency {
  ONE_TIME
  MONTHLY
}

enum PaymentMethod {
  CARD
  MOBILE_MONEY_MTN
  MOBILE_MONEY_AIRTEL
  BANK_TRANSFER
  OTHER
}

enum ActivityType {
  UPDATE
  PHOTO_STORY
  VIDEO
  POD
}

enum PartnerStatus {
  ACTIVE
  PAST
  PROSPECTIVE
}

enum AdminRole {
  OWNER
  EDITOR
}

enum SocialPlatform {
  INSTAGRAM
  TWITTER
  FACEBOOK
  TIKTOK
  OTHER
}
